{
  "name": "llamaparse-sponsor-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Motion-graphics sponsor segment for LlamaParse (LlamaIndex), rendered to video from HTML + GSAP.",
  "scripts": {
    "preview": "node tools/serve.mjs",
    "stills": "node tools/stills.mjs",
    "render": "node tools/render.mjs",
    "render:draft": "node tools/render.mjs --fps 30 --scale 0.5 --out out/draft.mp4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "gsap": "3.15.0",
    "lucide-static": "1.48.0",
    "playwright": "1.56.1"
  }
}
